<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0d6efd">
    <title>Productos - Código de barras</title>
    <link rel="manifest" href="/manifest.webmanifest">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/historial.css">
    <link rel="stylesheet" href="/productos.css">
</head>

<body class="bg-dark text-light min-vh-100">

    <div class="container py-4">
        <div class="header-container d-flex justify-content-between align-items-center mb-4">
            <a href="/seleccion" class="btn-icon-circular" title="Volver">
                <i class="fas fa-chevron-left"></i>
            </a>
            <div class="status-indicator">
                <span>Gestión de Productos</span>
            </div>
            <a href="/productos/crear?pagina=<%= paginaActual %>&buscar=<%= busqueda %>"
                class="btn-icon-circular btn-nuevo-producto" title="Nuevo producto">
                <i class="fas fa-plus"></i>
            </a>
        </div>

        <% const mensajes = {
            creado: 'Producto creado correctamente',
            actualizado: 'Producto actualizado correctamente',
            eliminado: 'Producto eliminado correctamente'
        }; %>
        <% const errores = {
            datos: 'Completa el ID y el nombre del producto',
            duplicado: 'Ya existe un producto con ese ID',
            crear: 'No se pudo crear el producto',
            actualizar: 'No se pudo actualizar el producto',
            eliminar: 'No se pudo eliminar el producto'
        }; %>

        <% if (mensaje && mensajes[mensaje]) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= mensajes[mensaje] %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        <% } %>
        <% if (error && errores[error]) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= errores[error] %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        <% } %>

        <form method="GET" action="/productos" class="contenedor-buscador">
            <input type="text" name="buscar" placeholder="Busca por nombre de producto" value="<%= busqueda %>">
        </form>

        <div class="mb-4 d-flex justify-content-between align-items-center">
            <h1 class="h2 text-primary mb-0 d-none d-md-block">Productos</h1>
            <a href="/productos/crear?pagina=<%= paginaActual %>&buscar=<%= busqueda %>"
                class="btn btn-primary btn-sm d-md-none">
                <i class="fas fa-plus me-1"></i> Nuevo
            </a>
        </div>

        <div id="contenedor-productos" class="table-responsive bg-secondary bg-opacity-10 rounded shadow">
            <table class="table table-dark table-hover mb-0">
                <thead class="table-primary">
                    <tr>
                        <th class="px-4 py-3">ID</th>
                        <th class="px-4 py-3">Nombre</th>
                        <th class="px-4 py-3">Categoría</th>
                        <th class="px-4 py-3">Stock</th>
                        <th class="px-4 py-3 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% productos.forEach(producto => { %>
                        <tr class="align-middle">
                            <td class="px-4"><%= producto.id_producto %></td>
                            <td class="px-4"><%= producto.nombre %></td>
                            <td class="px-4"><%= producto.categoria || '-' %></td>
                            <td class="px-4">
                                <span class="badge bg-primary fs-6"><%= producto.stock %></span>
                            </td>
                            <td class="px-4 text-center acciones-crud">
                                <a href="/productos/editar/<%= producto.id_producto %>?pagina=<%= paginaActual %>&buscar=<%= busqueda %>"
                                    class="btn btn-sm btn-warning" title="Editar">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <a href="/productos/eliminar/<%= producto.id_producto %>?pagina=<%= paginaActual %>&buscar=<%= busqueda %>"
                                    class="btn btn-sm btn-danger" title="Eliminar"
                                    onclick="return confirm('¿Eliminar este producto? Esta acción no se puede deshacer.');">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <% if (totalPaginas > 1) { %>
            <nav aria-label="Navegación de productos" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item <%= paginaActual === 1 ? 'disabled' : '' %>">
                        <a class="page-link bg-dark text-light border-secondary"
                            href="/productos?pagina=<%= paginaActual - 1 %>&buscar=<%= busqueda %>">Anterior</a>
                    </li>
                    <% for (let i = 1; i <= totalPaginas; i++) { %>
                        <li class="page-item <%= paginaActual === i ? 'active' : '' %>">
                            <a class="page-link <%= paginaActual === i ? 'bg-primary border-primary' : 'bg-dark text-light border-secondary' %>"
                                href="/productos?pagina=<%= i %>&buscar=<%= busqueda %>">
                                <%= i %>
                            </a>
                        </li>
                    <% } %>
                    <li class="page-item <%= paginaActual === totalPaginas ? 'disabled' : '' %>">
                        <a class="page-link bg-dark text-light border-secondary"
                            href="/productos?pagina=<%= paginaActual + 1 %>&buscar=<%= busqueda %>">Siguiente</a>
                    </li>
                </ul>
            </nav>
        <% } %>

        <% if (productos.length === 0) { %>
            <div class="text-center text-secondary mt-5 h4">
                No hay productos registrados
            </div>
        <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/pwa-register.js"></script>
</body>

</html>
