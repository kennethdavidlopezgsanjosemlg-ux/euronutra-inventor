<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Código de barras web</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/escaneo.css">
    <script src="https://cdn.jsdelivr.net/npm/html5-qrcode/minified/html5-qrcode.min.js"></script>
    <link href="//netdna.bootstrapcdn.com/bootstrap/3.0.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
    <script src="//netdna.bootstrapcdn.com/bootstrap/3.0.0/js/bootstrap.min.js"></script>
</head>

<body class="bg-dark text-light">

    <div class="container-fluid min-vh-100 d-flex flex-column position-relative">
        <div class="position-absolute top-0 start-50 translate-middle-x mt-4 z-3">
            <a href="/historial" class="button">Inventario</a>
        </div>

        <div class="flex-grow-1 d-flex flex-column justify-content-center align-items-center">
            <div id="contenedor-lector" class="w-100 ratio ratio-4x3 overflow-hidden rounded" style="max-width: 500px;">
                <div id="lector"></div>
                <div id="lector-placeholder" class="lector-placeholder">
                    <img src="https://i.redd.it/vmv1po3j74z21.jpg" alt="Cámara no disponible" class="lector-placeholder-img">
                </div>
            </div>
            <label class="switch mt-4">
                <input type="checkbox" id="toggle-camara" checked>
                <span class="slider"></span>
            </label>
            <div class="mt-4 btn-group" role="group" aria-label="Operación de stock">
                <input type="radio" class="btn-check" name="operacion" id="btn-sumar" value="sumar" checked autocomplete="off">
                <label class="btn btn-outline-success px-5 py-3 fs-4" for="btn-sumar">Sumar</label>
              
                <input type="radio" class="btn-check" name="operacion" id="btn-restar" value="restar" autocomplete="off">
                <label class="btn btn-outline-danger px-5 py-3 fs-4" for="btn-restar">Restar</label>
            </div>
        </div>

        <div id="notificacion" class="alert alert-success fixed-bottom mb-4 mx-auto d-none shadow-lg text-center"
            role="alert">
            <strong><span id="textoDetectado"></span></strong>
        </div>
    </div>

    <script src="/lectorController.js"></script>
</body>

</html>