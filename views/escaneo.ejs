<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Código de barras web</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        #lector video {
            object-fit: cover;
        }

        /* Ocultar elementos técnicos de la librería html5-qrcode */
        #qr-canvas,
        #qr-shaded-region {
            display: none;
        }

        #contenedor-lector {
            max-width: 500px;
            display: flex;
            justify-content: center;
            align-items: center;

        }

        body {
            /* Usamos colores mucho más cercanos para evitar el efecto "discoteca" */
            /* Azul muy oscuro -> Azul noche -> Gris azulado oscuro -> Azul profundo */
            background: linear-gradient(-45deg, #0f172a, #1e293b, #334155, #1e293b);
            background-size: 300% 300%;

            /* Animación mucho más lenta (30s en lugar de 15s) */
            animation: gradientBody 30s ease infinite;

            min-height: 100vh;
            margin: 0;
            /* Asegura que el color de fondo base sea oscuro por si acaso */
            background-color: #0f172a;
        }

        @keyframes gradientBody {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/html5-qrcode/minified/html5-qrcode.min.js"></script>
</head>

<body class="bg-dark text-light">

    <div class="container-fluid min-vh-100 d-flex flex-column position-relative">
        <div class="position-absolute top-0 start-50 translate-middle-x mt-4 z-3">
            <a href="/historial" class="btn btn-primary shadow-sm">Historial de Stock</a>
        </div>

        <div class="flex-grow-1 d-flex justify-content-center align-items-center">
            <div id="contenedor-lector" class="w-100 ratio ratio-4x3 overflow-hidden rounded" style="max-width: 500px;">
                <div id="lector"></div>
            </div>
        </div>

        <div id="notificacion" class="alert alert-success fixed-bottom mb-4 mx-auto d-none shadow-lg text-center"
            role="alert">
            <strong><span id="textoDetectado"></span></strong>
        </div>
    </div>

    <script src="/lectorController.js"></script>
</body>

</html>