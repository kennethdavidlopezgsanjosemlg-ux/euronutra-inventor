<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#0d6efd">
    <title>Código de barras web</title>
    <link rel="manifest" href="/manifest.webmanifest">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/escaneo.css">
    <script src="https://cdn.jsdelivr.net/npm/html5-qrcode/minified/html5-qrcode.min.js"></script>
</head>

<body class="bg-dark text-light">

    <div class="container-fluid vh-100 d-flex flex-column p-0 overflow-hidden">
        <!-- Header simple -->
        <div class="header-container d-flex justify-content-between align-items-center p-3">
            <a href="/seleccion" class="btn-icon-circular" title="Volver">
                <i class="fas fa-chevron-left"></i>
            </a>
            <div class="status-indicator">
                <span id="status-text">Iniciando...</span>
            </div>
            <div style="display:flex;gap:12px;align-items:center;">
                <label class="switch-minimal">
                    <input type="checkbox" id="toggle-camara" checked>
                    <span class="slider-minimal">
                        <i class="fas fa-camera"></i>
                    </span>
                </label>
                <div id="zoom-control-escaneo" style="display:none;align-items:center;gap:6px;">
                    <i class="fas fa-search-minus" style="color:#94a3b8"></i>
                    <input id="zoom-range-escaneo" type="range" min="1" max="1" step="0.1" value="1" style="width:120px;">
                    <i class="fas fa-search-plus" style="color:#94a3b8"></i>
                </div>
            </div>
        </div>

        <div class="main-content flex-grow-1 d-flex flex-column justify-content-center align-items-center">
            <!-- Contenedor del Lector con guía visual -->
            <div class="scanner-wrapper">
                <div id="contenedor-lector" class="rounded-4 border-0">
                    <div id="lector"></div>
                    <div id="lector-placeholder" class="lector-placeholder">
                        <div class="placeholder-content">
                            <i class="fas fa-camera-slash mb-3 fs-1"></i>
                            <p>Cámara desactivada</p>
                        </div>
                    </div>
                    <div class="scanner-guide"></div>
                    <div id="resultado-escaneo" class="resultado-overlay d-none">
                        <div class="resultado-content">
                            <i id="res-icon" class="fas fa-check-circle mb-2"></i>
                            <div id="res-text"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Selector de operación -->
            <div class="operation-selector-container">
                <div class="operation-selector">
                    <input type="radio" name="operacion" id="btn-sumar" value="sumar" checked>
                    <label for="btn-sumar" class="op-btn op-sumar">
                        <i class="fas fa-plus-circle me-2"></i> Sumar
                    </label>

                    <input type="radio" name="operacion" id="btn-restar" value="restar">
                    <label for="btn-restar" class="op-btn op-restar">
                        <i class="fas fa-minus-circle me-2"></i> Restar
                    </label>
                </div>
            </div>
        </div>
    </div>

    <script src="/lectorController.js"></script>
    <script src="/pwa-register.js"></script>
    <script src="/no-zoom.js"></script>
</body>

</html>