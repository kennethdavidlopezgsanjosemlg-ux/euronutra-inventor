<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Código de Barras</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome para los iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>

body {
  /* Usamos colores mucho más cercanos para evitar el efecto "discoteca" */
  /* Azul muy oscuro -> Azul noche -> Gris azulado oscuro -> Azul profundo */
  background: linear-gradient(-45deg, #0f172a, #1e293b, #334155, #1e293b);
  background-size: 300% 300%;
  
  /* Animación mucho más lenta (30s en lugar de 15s) */
  animation: gradientBody 30s ease infinite;
  
  min-height: 100vh;
  margin: 0;
  /* Asegura que el color de fondo base sea oscuro por si acaso */
  background-color: #0f172a; 
}

@keyframes gradientBody {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

<body class="bg-dark text-light">

    <section class="min-vh-100 d-flex align-items-center">
        <div class="container px-4 py-5 px-md-5 text-center text-lg-start">
            <div class="row gx-lg-5 align-items-center mb-5">
                <div class="col-lg-6 mb-5 mb-lg-0" style="z-index: 10">
                    <h1 class="my-5 display-5 fw-bold ls-tight text-primary">
                        Euronutra <br />
                        <span class="text-white-50">Gestión de Stock</span>
                    </h1>
                    <p class="mb-4 opacity-70 text-light">
                        Acceda al sistema para realizar el escaneo de productos y gestionar el historial de inventario
                        de manera eficiente.
                    </p>
                </div>

                <div class="col-lg-6 mb-5 mb-lg-0 position-relative">
                    <div class="card bg-secondary bg-opacity-25 border-0 shadow-lg"
                        style="backdrop-filter: blur(10px);">
                        <div class="card-body px-4 py-5 px-md-5 text-white">

                            <!-- mensaje de errores -->
                            <% if (typeof error !=='undefined' && error) { %>
                                <% if (error==='auth' ) { %>
                                    <div class="alert alert-danger text-center mb-4">
                                        <i class="fas fa-exclamation-circle me-2"></i> Usuario o contraseña incorrectos
                                    </div>
                                    <% } else if (error==='server' ) { %>
                                        <div class="alert alert-warning text-center mb-4">
                                            <i class="fas fa-server me-2"></i> Error en el servidor. Inténtalo más
                                            tarde.
                                        </div>
                                        <% } %>
                                            <% } %>

                                                <form action="/login" method="POST">
                                                    <!-- Email input -->
                                                    <div class="form-outline mb-4">
                                                        <label class="form-label" for="email">Correo Electrónico</label>
                                                        <input type="email" id="email" name="email" class="form-control"
                                                            placeholder="ejemplo@correo.com" required />
                                                    </div>

                                                    <!-- Password input -->
                                                    <div class="form-outline mb-4">
                                                        <label class="form-label" for="password">Contraseña</label>
                                                        <input type="password" id="password" name="password"
                                                            class="form-control" placeholder="••••••••" required />
                                                    </div>

                                                    <!-- Submit button -->
                                                    <button type="submit"
                                                        class="btn btn-primary btn-block mb-4 w-100 fw-bold">
                                                        Iniciar Sesión
                                                    </button>

                                                    <!-- Register buttons -->
                                                    <div class="text-center mt-3">
                                                        <p class="small text-white-50">o entrar con:</p>
                                                        <button type="button"
                                                            class="btn btn-outline-light btn-floating mx-1">
                                                            <i class="fab fa-facebook-f"></i>
                                                        </button>

                                                        <button type="button"
                                                            class="btn btn-outline-light btn-floating mx-1">
                                                            <i class="fab fa-google"></i>
                                                        </button>

                                                        <button type="button"
                                                            class="btn btn-outline-light btn-floating mx-1">
                                                            <i class="fab fa-github"></i>
                                                        </button>
                                                    </div>
                                                    <div>
                                                        <p class=" text-primary mt-2">Realizado por Kenneth David López
                                                            Guerrero</p>
                                                    </div>
                                                </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>