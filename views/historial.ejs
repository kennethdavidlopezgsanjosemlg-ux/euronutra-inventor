<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#0d6efd">
    <title>Historial - Código de barras</title>
    <link rel="manifest" href="/manifest.webmanifest">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/historial.css">
</head>

<body class="bg-dark text-light min-vh-100">

    <div class="container py-4">
        <div class="header-container d-flex justify-content-between align-items-center mb-4">
            <a href="/seleccion" class="btn-icon-circular" title="Volver">
                <i class="fas fa-chevron-left"></i>
            </a>
            <div class="status-indicator">
                <span>Historial de Artículos</span>
            </div>
            <a href="/escaneo" class="btn-icon-circular" title="Cámara">
                <i class="fas fa-camera"></i>
            </a>
        </div>

        <div class="contenedor-buscador">
            <input type="text" id="buscador" placeholder="Busca por nombre de producto" value="<%= busqueda %>">
        </div>

        <div class="mb-4 d-flex justify-content-between align-items-center">
            <h1 class="h2 text-primary mb-0 d-none d-md-block">Inventario</h1>
        <div class="filter-container">
                <button title="filter" class="filter-minimal-btn" type="button">
                    <i class="fas fa-filter"></i> Filtrar
                </button>
                <div class="orden-dropdown">
                        <button type="button" class="orden-item" data-sort="mayor-stock">Mayor stock</button>
                        <button type="button" class="orden-item" data-sort="menor-stock">Menor stock</button>
                        <button type="button" class="orden-item" data-sort="id">Por ID</button>
                </div>
            </div>
        </div>

        <!-- Tabla de artículos -->
        <div id="contenedor-productos" class="table-responsive bg-secondary bg-opacity-10 rounded shadow">
            <table class="table table-dark table-hover mb-0">
                <thead class="table-primary">
                    <tr>
                        <th class="px-4 py-3">ID</th>
                        <th class="px-4 py-3">Nombre</th>
                        <th class="px-4 py-3">Categoría</th>
                        <th class="px-4 py-3">Stock</th>
                        <th class="px-4 py-3 text-center">Quitar Stock</th>
                    </tr>
                </thead>
                <tbody>
                    <% articulos.forEach(articulo=> { %>
                        <tr id="row-<%= articulo.id_producto %>" class="align-middle" data-stock="<%= articulo.stock %>" data-id="<%= articulo.id_producto %>">
                            <td class="px-4" data-label="ID">
                                <%= articulo.id_producto %>
                            </td>
                            <td class="px-4" data-label="Nombre">
                                <%= articulo.nombre %>
                            </td>
                            <td class="px-4" data-label="Categoría">
                                <%= articulo.categoria || '-' %>
                            </td>
                            <td class="px-4" data-label="Stock">
                                <span class="badge bg-primary fs-6" id="stock-<%= articulo.id_producto %>">
                                    <%= articulo.stock %>
                                </span>
                            </td>
                            <td class="px-4 text-center" data-label="Quitar Stock">
                                <a href="/disminuir/<%= articulo.id_producto %>?pagina=<%= paginaActual %>&buscar=<%= busqueda %>"
                                    class="btn btn-sm btn-danger boton-disminuir" data-id="<%= articulo.id_producto %>">
                                    -1
                                </a>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        <% if (totalPaginas > 1) { %>
            <nav aria-label="Navegación de historial" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item <%= paginaActual === 1 ? 'disabled' : '' %>">
                        <a class="page-link bg-dark text-light border-secondary" href="/historial?pagina=<%= paginaActual - 1 %>&buscar=<%= busqueda %>">Anterior</a>
                    </li>
                    
                    <% for(let i = 1; i <= totalPaginas; i++) { %>
                        <li class="page-item <%= paginaActual === i ? 'active' : '' %>">
                            <a class="page-link <%= paginaActual === i ? 'bg-primary border-primary' : 'bg-dark text-light border-secondary' %>" href="/historial?pagina=<%= i %>&buscar=<%= busqueda %>">
                                <%= i %>
                            </a>
                        </li>
                    <% } %>

                    <li class="page-item <%= paginaActual === totalPaginas ? 'disabled' : '' %>">
                        <a class="page-link bg-dark text-light border-secondary" href="/historial?pagina=<%= paginaActual + 1 %>&buscar=<%= busqueda %>">Siguiente</a>
                    </li>
                </ul>
            </nav>
        <% } %>

        <!-- Por si no hay artículos-->
        <% if (articulos.length===0) { %>
            <div class="text-center text-secondary mt-5 h4">
                No hay artículos registrados
            </div>
            <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/historial.js"></script>
    <script src="/paginacion.js"></script>
    <script src="/pwa-register.js"></script>
    <script src="/no-zoom.js"></script>
</body>

</html>