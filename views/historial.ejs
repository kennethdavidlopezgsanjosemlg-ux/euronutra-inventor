<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Historial - Código de barras</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/historial.css">
</head>

<body class="bg-dark text-light min-vh-100">

    <div class="container py-4">
        <div class="header-container d-flex justify-content-between align-items-center mb-4">
            <a href="/seleccion" class="btn-icon-circular" title="Volver">
                <i class="fas fa-chevron-left"></i>
            </a>
            <div class="status-indicator">
                <span>Historial de Artículos</span>
            </div>
            <a href="/escaneo" class="btn-icon-circular" title="Cámara">
                <i class="fas fa-camera"></i>
            </a>
        </div>

        <div class="mb-4 d-flex justify-content-between align-items-center">
            <h1 class="h2 text-primary mb-0 d-none d-md-block">Inventario</h1>
        <div class="filter-container">
                <button title="filter" class="filter-minimal-btn" type="button">
                    <i class="fas fa-filter"></i> Filtrar
                </button>
                <div class="orden-dropdown">
                        <button type="button" class="orden-item" data-sort="mayor-stock">Mayor stock</button>
                        <button type="button" class="orden-item" data-sort="menor-stock">Menor stock</button>
                        <button type="button" class="orden-item" data-sort="id">Por ID</button>
                </div>
            </div>
        </div>

        <!-- Tabla de artículos -->
        <div id="contenedor-productos" class="table-responsive bg-secondary bg-opacity-10 rounded shadow">
            <table class="table table-dark table-hover mb-0">
                <thead class="table-primary">
                    <tr>
                        <th class="px-4 py-3">ID</th>
                        <th class="px-4 py-3">Nombre</th>
                        <th class="px-4 py-3">Categoría</th>
                        <th class="px-4 py-3">Stock</th>
                        <th class="px-4 py-3 text-center">Quitar Stock</th>
                    </tr>
                </thead>
                <tbody>
                    <% articulos.forEach(articulo=> { %>
                        <tr id="row-<%= articulo.id_producto %>" class="align-middle" data-stock="<%= articulo.stock %>" data-id="<%= articulo.id_producto %>">
                            <td class="px-4">
                                <%= articulo.id_producto %>
                            </td>
                            <td class="px-4">
                                <%= articulo.nombre %>
                            </td>
                            <td class="px-4">
                                <%= articulo.categoria || '-' %>
                            </td>
                            <td class="px-4">
                                <span class="badge bg-primary fs-6" id="stock-<%= articulo.id_producto %>">
                                    <%= articulo.stock %>
                                </span>
                            </td>
                            <td class="px-4 text-center">
                                <a href="/disminuir/<%= articulo.id_producto %>"
                                    class="btn btn-sm btn-danger boton-disminuir" data-id="<%= articulo.id_producto %>">
                                    -1
                                </a>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </div>

        <!-- Por si no hay artículos-->
        <% if (articulos.length===0) { %>
            <div class="text-center text-secondary mt-5 h4">
                No hay artículos registrados
            </div>
            <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const ordenItems = document.querySelectorAll('.orden-item');
        const tbody = document.querySelector('#contenedor-productos tbody');

        function sortRows(criteria) {
            const rows = Array.from(tbody.querySelectorAll('tr'));
            rows.sort((a, b) => {
                const stockA = Number(a.dataset.stock || 0);
                const stockB = Number(b.dataset.stock || 0);
                const idA = Number(a.dataset.id || 0);
                const idB = Number(b.dataset.id || 0);

                if (criteria === 'mayor-stock') return stockB - stockA;
                if (criteria === 'menor-stock') return stockA - stockB;
                return idA - idB;
            });
            rows.forEach(row => tbody.appendChild(row));
        }

        ordenItems.forEach(item => {
            item.addEventListener('click', () => {
                sortRows(item.dataset.sort);
            });
        });
    </script>
</body>

</html>